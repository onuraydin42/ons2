# Where both order-portal forms deliver.
#
# Web3Forms is recommended: it accepts a base64 data URL and emails the
# signature as a real attachment on the free tier. Create a key at
# https://web3forms.com — the access key is public by design and only
# permits posting to the inbox it was issued for.
#
# Formspree works with the same JSON shape but truncates large fields, so a
# full-resolution signature can arrive clipped.
NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Shown as the mailto fallback if a submission fails.
NEXT_PUBLIC_CONTACT_EMAIL=orders@fluidounce.co
